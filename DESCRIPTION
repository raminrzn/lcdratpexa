Package: lcdratpexa
Title: LCDRAT Lung Cancer Death Risk (Katki 2016) - ModelsCloud Service
Version: 0.1.0
Authors@R: c(
    person("Ramin", "Rezaeianzadeh", email = "raminrzn@student.ubc.ca",
